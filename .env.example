# 复制为 .env 后填写；.env 已被 .gitignore 忽略，勿提交真实值。
# 评测驱动 scripts/eval/run_video_qa.py 读取以下变量。
export GLAUX_EVAL_QWEN_KEY=
export GLAUX_EVAL_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选：须与 agent-runtime 进程的 GLAUX_BACKEND_URL 一致，缺省 http://127.0.0.1:8000
# export GLAUX_BACKEND_URL=http://127.0.0.1:8000
