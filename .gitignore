# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.venv/
venv/
env/

# 数据集不入库（CUBS 走下载，见 science-core/README.md）——锚定仓库根，勿误伤 src/data/
# 注：/data/<dir>/ 仍忽略二进制，但 README.md 重新放行
/data/*
!/data/ct/
!/data/ct/README.md
# SAM 自然图像演示资产体积小且许可明确，随仓库分发。
!/data/natural/
!/data/natural/README.md
!/data/natural/*.jpg
# P7：WSI demo slide/reference 走 runbook 生成，仅放行 README（同 /data/ct/ 模式）
!/data/wsi/
/data/wsi/*
!/data/wsi/README.md
*.tiff
*.tif
# P7：WSI vendor 切片二进制不入库（demo slide 走 runbook 下载）
*.svs
*.ndpi
*.mrxs
# P6：CT NIfTI 体积/labelmap 不入库
*.nii
*.nii.gz

# 模型权重不入库
*.h5
*.ckpt
*.pt
*.pth

# Node / 前端
node_modules/
frontend/dist/
agent-runtime/dist/
agent-runtime/coverage/
*.tsbuildinfo
npm-debug.log*
.eslintcache

# Agent Runtime 本地会话数据
.glaux/

# 本地开发配置（含机器相关的 WSL/nvm 绝对路径，不入库）
.claude/launch.json

# OS / 编辑器
.DS_Store
*.swp
.idea/
.vscode/
.qoder/
